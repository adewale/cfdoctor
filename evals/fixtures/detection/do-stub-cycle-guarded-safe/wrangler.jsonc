{
  // Two DOs that do call each other, but every hop checks an explicit depth
  // budget before making the next stub call. False-positive guard: a bounded
  // ping-pong is a legitimate request/response pattern.
  "name": "session-handshake",
  "main": "src/index.js",
  "compatibility_date": "2026-05-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "SESSION_COORDINATOR", "class_name": "SessionCoordinator" },
      { "name": "TASK_RUNNER", "class_name": "TaskRunner" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionCoordinator", "TaskRunner"] }]
}
