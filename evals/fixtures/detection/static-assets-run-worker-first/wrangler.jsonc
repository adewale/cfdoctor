{
  // Static Assets project that forces the Worker to run first for ALL requests,
  // turning normally-free asset hits into billable Worker invocations.
  "name": "assets-first",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
