{
  // Agent session coordinator plus task runner, modeled on the 2026-08 StandardAgents bill:
  // two Durable Objects re-trigger each other and re-scan a growing SQLite table every hop.
  "name": "agent-session-loop",
  "main": "src/index.js",
  "compatibility_date": "2026-05-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "SESSION_COORDINATOR", "class_name": "SessionCoordinator" },
      { "name": "TASK_RUNNER", "class_name": "TaskRunner" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionCoordinator", "TaskRunner"] }]
}
