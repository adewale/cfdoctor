    {"id": "CFDOC-EVD-D1-134-BILL", "source_cluster_id": "whatmedicaidpays-d1-row-read-bill", "evidence_class": "incident", "title": "Unindexed hot D1 queries generated 127 billion row reads", "status": "accepted", "taxonomy": ["read-amplification", "missing-index", "hot-path-query"], "mechanism": "Two layout queries ran on every page and repeatedly scanned a roughly 765,000-row table; composite indexes, ANALYZE, and caching reduced the measured row-read amplification.", "sources": [{"url": "https://fullstacksveltekit.com/blog/cloudflare-d1-bill", "role": "primary", "author_org": "whatmedicaidpays operator", "published_at": "2026-04-25", "first_hand": true}], "current_semantics_urls": ["https://developers.cloudflare.com/d1/platform/pricing/", "https://developers.cloudflare.com/d1/observability/metrics-analytics/", "https://developers.cloudflare.com/d1/best-practices/use-indexes/"], "verified_at": "2026-07-11", "review_due": "2026-10-11", "confidence": {"authenticity": 2, "mechanism": 2, "independence": 1, "applicability": 2, "temporal": 2}, "scenario_numbers": [], "check_ids": [], "fixture_ids": []},
    {"id": "CFDOC-EVD-DO-ALARM-34K", "source_cluster_id": "hn-do-alarm-preview-loop-34k", "evidence_class": "incident", "title": "Durable Object alarm and preview-instance loop claim", "status": "unverified", "taxonomy": ["recursive-trigger", "storage-amplification", "preview-leakage"], "mechanism": "A first-hand HN report says an unconditional one-minute alarm scheduled on every wake across more than 60 preview deployments generated extreme SQLite row reads. The code shape is plausible and current docs corroborate alarm/storage meters, but the invoice and account metrics are not independently verified. The 2026-08 StandardAgents bill (CFDOC-EVD-STDAGENTS-DO-LOOP, separate source cluster) independently corroborates the mechanism class: detached Durable Object re-triggering with per-hop reads makes SQLite storage rows read the dominant meter.", "sources": [{"url": "https://news.ycombinator.com/item?id=47787042", "role": "primary", "author_org": "anonymous Durable Objects operator", "published_at": "2026-04-15", "first_hand": true}], "current_semantics_urls": ["https://developers.cloudflare.com/durable-objects/api/alarms/", "https://developers.cloudflare.com/durable-objects/platform/pricing/", "https://developers.cloudflare.com/workers/versions-and-deployments/preview-urls/"], "verified_at": "2026-08-09", "review_due": "2026-09-08", "confidence": {"authenticity": 1, "mechanism": 2, "independence": 0, "applicability": 2, "temporal": 2}, "scenario_numbers": [], "check_ids": ["DO-ALARM-RECURSION", "CFDOC-COST-TEMP-ENV-PAID-BINDINGS"], "fixture_ids": []},
    {"id": "CFDOC-EVD-WIRE-DO-EXIT", "source_cluster_id": "wire-durable-objects-architecture-exit", "evidence_class": "operator-note", "title": "Wire moved its retrieval data plane off Durable Objects", "status": "accepted", "taxonomy": ["product-fit", "data-locality", "placement", "portability"], "mechanism": "Wire reports that separate Vectorize state, network hops, creation-time placement, shared compute, and lack of self-hosting conflicted with its retrieval workload, while explicitly retaining Workers and recommending Durable Objects for workloads without those requirements.", "sources": [{"url": "https://usewire.io/engineering/why-were-moving-wire-off-cloudflare-durable-objects/", "role": "primary", "author_org": "Wire", "published_at": "2026-07-07", "first_hand": true}, {"url": "https://usewire.io/why-wire/architecture-benchmark/", "role": "supporting", "author_org": "Wire", "published_at": "2026-07-06", "first_hand": true}], "current_semantics_urls": ["https://developers.cloudflare.com/durable-objects/reference/data-location/", "https://developers.cloudflare.com/vectorize/", "https://developers.cloudflare.com/durable-objects/api/sqlite-storage-api/"], "verified_at": "2026-07-11", "review_due": "2026-10-11", "confidence": {"authenticity": 2, "mechanism": 2, "independence": 1, "applicability": 1, "temporal": 2}, "scenario_numbers": [], "check_ids": [], "fixture_ids": []},
    {"id": "CFDOC-EVD-CF-BYOIP-20260220", "source_cluster_id": "cloudflare-byoip-withdrawal-2026", "evidence_class": "incident", "title": "Cloudflare BYOIP configuration rollout withdrew customer prefixes", "status": "accepted", "taxonomy": ["configuration-blast-radius", "rollback", "control-plane"], "mechanism": "A malformed cleanup query selected all BYOIP prefixes instead of pending deletions, propagating withdrawals and deleting dependent service bindings; recovery exposed gaps in staged rollout, mock fidelity, circuit breakers, desired/operational-state separation, and rollback.", "sources": [{"url": "https://blog.cloudflare.com/cloudflare-outage-february-20-2026/", "role": "primary", "author_org": "Cloudflare", "published_at": "2026-02-21", "first_hand": true}], "current_semantics_urls": ["https://developers.cloudflare.com/byoip/", "https://developers.cloudflare.com/byoip/service-bindings/"], "verified_at": "2026-07-11", "review_due": "2026-10-11", "confidence": {"authenticity": 2, "mechanism": 2, "independence": 1, "applicability": 1, "temporal": 2}, "scenario_numbers": [], "check_ids": [], "fixture_ids": []},
    {"id": "CFDOC-EVD-CF-KV-OUTAGE-20250612", "source_cluster_id": "cloudflare-kv-dependency-outage-2025", "evidence_class": "incident", "title": "Cloudflare service outage propagated through a Workers KV dependency", "status": "accepted", "taxonomy": ["dependency-failure", "control-plane", "failover"], "mechanism": "A third-party cloud-provider outage made the central Workers KV storage infrastructure unavailable and propagated into services that depended on KV, exposing hidden critical-path coupling and insufficient independent fallback for configuration and authentication paths.", "sources": [{"url": "https://blog.cloudflare.com/cloudflare-service-outage-june-12-2025/", "role": "primary", "author_org": "Cloudflare", "published_at": "2025-06-12", "first_hand": true}], "current_semantics_urls": ["https://developers.cloudflare.com/kv/reference/how-kv-works/"], "verified_at": "2026-07-11", "review_due": "2026-10-11", "confidence": {"authenticity": 2, "mechanism": 2, "independence": 1, "applicability": 1, "temporal": 2}, "scenario_numbers": [], "check_ids": [], "fixture_ids": []},
    {"id": "CFDOC-EVD-CF-FEATURE-FILE-20251118", "source_cluster_id": "cloudflare-feature-file-outage-2025", "evidence_class": "incident", "title": "Cloudflare feature-file propagation caused a core network outage", "status": "accepted", "taxonomy": ["configuration-blast-radius", "validation", "rollback"], "mechanism": "A database permission change caused a feature-generation query to emit an unexpectedly large file. Rapid global propagation and unsafe ingestion made core proxy software fail; alternating good and bad files complicated diagnosis until generation stopped and a known-good file was restored.", "sources": [{"url": "https://blog.cloudflare.com/18-november-2025-outage/", "role": "primary", "author_org": "Cloudflare", "published_at": "2025-11-18", "first_hand": true}], "current_semantics_urls": [], "verified_at": "2026-07-11", "review_due": "2026-10-11", "confidence": {"authenticity": 2, "mechanism": 2, "independence": 1, "applicability": 1, "temporal": 2}, "scenario_numbers": [], "check_ids": [], "fixture_ids": []},
    {"id": "CFDOC-EVD-STDAGENTS-DO-LOOP", "source_cluster_id": "standardagents-do-stub-loop-8846", "evidence_class": "incident", "title": "Two Durable Objects re-triggered each other into an $8,846 rows-read bill", "status": "accepted", "taxonomy": ["recursive-trigger", "storage-amplification", "spend-control", "detection-latency"], "mechanism": "StandardAgents reports that two Durable Objects deep in their stack re-triggered each other for roughly three weeks. The attached spend summary shows Durable Objects Storage Rows Read at $8,710.39 of an $8,846.78 cycle (98.5%) versus under $50 each for DO compute requests, duration, and rows written - the signature of per-hop re-reads of growing SQLite state. Daily spend ramped from ~$40 to ~$600, stopped around 2026-07-30, and was discovered from the cycle-end bill on 2026-08-08; the auto-created $10 default budget alert reported 88,468% of budget at cycle close and pre-existing Workers-scoped notifications could not see the DO storage meter. The exact in-code trigger (stub calls vs alarms) is operator-stated, not code-verified.", "sources": [{"url": "https://x.com/jpschroeder/status/2086144942657712500", "role": "primary", "author_org": "StandardAgents co-founder (Justin Schroeder)", "published_at": "2026-08-08", "first_hand": true}, {"url": "https://x.com/0xboyd/status/2086136894803279932", "role": "supporting", "author_org": "StandardAgents (Boyd)", "published_at": "2026-08-08", "first_hand": true}, {"url": "https://x.com/0xboyd/status/2086143037042749480", "role": "supporting", "author_org": "StandardAgents (Boyd)", "published_at": "2026-08-08", "first_hand": true}], "current_semantics_urls": ["https://developers.cloudflare.com/durable-objects/platform/pricing/", "https://developers.cloudflare.com/billing/manage/budget-alerts/", "https://developers.cloudflare.com/billing/manage/billable-usage/", "https://developers.cloudflare.com/workers/platform/limits/"], "verified_at": "2026-08-09", "review_due": "2026-09-08", "confidence": {"authenticity": 2, "mechanism": 1, "independence": 0, "applicability": 2, "temporal": 2}, "scenario_numbers": [24], "check_ids": ["DO-STUB-CALL-CYCLE", "DO-SQL-SCAN-HOTPATH", "CFDOC-COST-SPEND-ALERTS-ONLY"], "fixture_ids": ["do-stub-call-cycle", "do-sql-unbounded-scan", "do-stub-chain-safe", "do-stub-cycle-guarded-safe"]},
    {"id": "CFDOC-EVD-CF-BUDGET-ALERTS", "source_cluster_id": "cloudflare-budget-alerts-billable-usage", "evidence_class": "official-guidance", "title": "Cloudflare budget alerts and billable usage are visibility, not caps", "status": "accepted", "taxonomy": ["spend-control", "detection-latency"], "mechanism": "Cloudflare budget alerts evaluate cumulative usage-based spend for the current billing period and send a single informational email per crossed threshold; they do not pause or cap usage, apply to Pay-as-you-go accounts only, and eligible accounts receive an auto-created $10 default alert each cycle (default-on since 2026-06-15). The billable usage dashboard and API expose daily per-product cost from the invoice pipeline, so daily review or polling is the reliable runaway-meter watch. Alert delivery latency observed in the field (cycle-end delivery in the StandardAgents incident) is operator evidence, not documented semantics; verify current behavior before relying on alert timing.", "sources": [{"url": "https://developers.cloudflare.com/billing/manage/budget-alerts/", "role": "primary", "author_org": "Cloudflare", "published_at": "2026-04-13", "first_hand": false}, {"url": "https://developers.cloudflare.com/changelog/post/2026-06-15-budget-alerts-default-on/", "role": "supporting", "author_org": "Cloudflare", "published_at": "2026-06-15", "first_hand": false}, {"url": "https://blog.cloudflare.com/billable-usage-api/", "role": "supporting", "author_org": "Cloudflare", "published_at": "2026-08-03", "first_hand": false}], "current_semantics_urls": ["https://developers.cloudflare.com/billing/manage/budget-alerts/", "https://developers.cloudflare.com/billing/manage/billable-usage/"], "verified_at": "2026-08-09", "review_due": "2026-09-08", "confidence": {"authenticity": 2, "mechanism": 2, "independence": 2, "applicability": 2, "temporal": 2}, "scenario_numbers": [], "check_ids": ["CFDOC-COST-SPEND-ALERTS-ONLY"], "fixture_ids": []}
