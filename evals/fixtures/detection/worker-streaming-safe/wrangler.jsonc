{
  // Same upload/proxy shape, written to stream bodies and bound request size.
  // False-positive guard: the scanner must emit zero findings here.
  "name": "media-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "media-uploads" }]
}
