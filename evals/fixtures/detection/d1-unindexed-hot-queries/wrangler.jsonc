{
  // Public Medicaid reimbursement lookup site: SvelteKit on Workers with one D1 database.
  "name": "what-medicaid-pays",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-05-01",
  "observability": { "enabled": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "medicaid", "database_id": "0000fixture0000" }
  ]
}
